---
interface Props {
  username: string;
}

const { username } = Astro.props;

const query = `
  query {
    user(login: "${username}") {
      contributionsCollection {
        contributionCalendar {
          totalContributions
          weeks {
            contributionDays {
              contributionCount
              date
            }
          }
        }
      }
    }
  }
`;

let contributionData: any = null;
let error: string | null = null;

try {
  const token = import.meta.env.GITHUB_TOKEN;
  if (!token) {
    throw new Error('GITHUB_TOKEN environment variable not set');
  }

  const response = await fetch('https://api.github.com/graphql', {
    method: 'POST',
    headers: {
      'Authorization': `Bearer ${token}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ query }),
  });

  const result = await response.json();

  if (result.errors) {
    error = result.errors[0]?.message || 'Failed to fetch GitHub data';
  } else {
    contributionData = result.data?.user?.contributionsCollection?.contributionCalendar;
  }
} catch (err) {
  error = err instanceof Error ? err.message : 'Failed to fetch GitHub contributions';
  console.error('GitHub Heatmap Error:', error);
}

const getContributionColor = (count: number): string => {
  if (count === 0) return '#262626';
  if (count < 5) return '#a78bfa';
  if (count < 10) return '#8b5cf6';
  if (count < 15) return '#7c3aed';
  if (count < 20) return '#6d28d9';
  return '#5b21b6';
};
---

{error ? (
  <div class="github-heatmap-error">
    <p>Failed to load GitHub contributions</p>
  </div>
) : contributionData ? (
  <div class="github-heatmap">
    <div class="heatmap-header">
      <h3 class="no-mt">Contributions</h3>
      <span class="contribution-count">{contributionData.totalContributions} contributions</span>
    </div>

    <svg
      class="heatmap-svg"
      width="100%"
      height="120"
      viewBox="0 0 730 120"
    >
      {contributionData.weeks.map((week: any, weekIndex: number) => (
        <g key={weekIndex}>
          {week.contributionDays.map((day: any, dayIndex: number) => {
            const x = weekIndex * 13;
            const y = dayIndex * 13;
            const color = getContributionColor(day.contributionCount);

            return (
              <g key={`${weekIndex}-${dayIndex}`}>
                <rect
                  x={x}
                  y={y}
                  width="11"
                  height="11"
                  fill={color}
                  rx="2"
                  class="heatmap-cell"
                  data-date={day.date}
                  data-count={day.contributionCount}
                />
              </g>
            );
          })}
        </g>
      ))}
    </svg>

    <div class="heatmap-legend">
      <span>Less</span>
      <div class="legend-boxes">
        <div class="legend-box" style="background-color: #262626;"></div>
        <div class="legend-box" style="background-color: #a78bfa;"></div>
        <div class="legend-box" style="background-color: #8b5cf6;"></div>
        <div class="legend-box" style="background-color: #7c3aed;"></div>
        <div class="legend-box" style="background-color: #5b21b6;"></div>
      </div>
      <span>More</span>
    </div>
  </div>
) : (
  <div class="github-heatmap-loading">
    <p>Loading GitHub contributions...</p>
  </div>
)}

<style>
.github-heatmap {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  align-items: center;
}

.heatmap-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}

.heatmap-header h3 {
  margin: 0;
}

.contribution-count {
  font-size: 0.875rem;
  color: #c7c7c7;
}

.heatmap-svg {
  border-radius: 4px;
  background-color: rgba(0, 0, 0, 0.2);
  padding: 8px;
}

.heatmap-cell {
  cursor: pointer;
  transition: opacity 0.2s ease;
}

.heatmap-cell:hover {
  opacity: 0.8;
}

.heatmap-legend {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.75rem;
  color: #c7c7c7;
}

.legend-boxes {
  display: flex;
  gap: 0.25rem;
}

.legend-box {
  width: 12px;
  height: 12px;
  border-radius: 2px;
}

.github-heatmap-error,
.github-heatmap-loading {
  padding: 1rem;
  text-align: center;
  color: #c7c7c7;
  font-size: 0.875rem;
}
</style>
